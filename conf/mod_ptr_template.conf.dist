[worldserver]

#
#    AnnounceEnable
#        Description: Enable the module announcing its presence.
#        Default:     true  - (Enabled)
#                     false - (Disabled)

AnnounceEnable = true

#
#    TemplateEnable
#        Description: Enable the application of templates.
#        Default:     true  - (Enabled)
#                     false - (Disabled)

TemplateEnable = true

#
#    LevelEnable
#        Description: Enable templates to be applied at any level.
#        Default:     true  - (Enabled, any level)
#                     false - (Disabled, only at StartPlayerLevel)

LevelEnable = true

#
#   TemplateAchievements
#   TemplateBagGear
#   TemplateDK
#   TemplateEquipGear
#   TemplateHomebind
#   TemplateHotbar
#   TemplateLevel
#   TemplateQuests       - false
#   TemplateReputation
#   TemplateResources
#   TemplateSkills
#   TemplateSpells
#   TemplateTalents
#   TemplateTaximask
#   TemplateTeleport
#       Description: Enable various aspects of template sets to be applied.
#       Defaults:    true  - (Enabled)
#                    false - (Disabled)

TemplateAchievements = true
TemplateBagGear      = true
TemplateDK           = true
TemplateEquipGear    = true
TemplateHomebind     = true
TemplateHotbar       = true
TemplateLevel        = true
TemplateQuests       = false
TemplateReputation   = true
TemplateResources    = true
TemplateSkills       = true
TemplateSpells       = true
TemplateTalents      = true
TemplateTaximask     = true
TemplateTeleport     = true

#
#   TemplateTalentRanks
#       Description: Learn the trainer ranks, up to the character's level, of every ability a
#                    learned talent teaches (a talent gives rank 1 only: Pyroblast, Devastate,
#                    Haunt ...). Never a further rank of the talent itself.
#       Default:     true
#
#   TemplateParagon
#   TemplateParagon.MinLevel
#       Description: Raise the account's Paragon level (mod-paragon) to at least MinLevel before
#                    the gear; never lowers it, capped at Paragon.MaxLevel. 0 = no floor.
#       Default:     true, 200
#
#   TemplateClassKit
#   TemplateHunterPet.Entry
#       Description: What no template row carries: a hunter's ammo (a matching arrow or bullet
#                    from the bags) and pet (a tamed pet of creature Entry at the hunter's level,
#                    unless the hunter has one), a shaman's four totems (5175-5178).
#       Default:     true, 26672 (Bloodthirsty Tundra Wolf; must be tameable)
#
#   TemplateParagonRolls
#       Description: mod-paragon-itemgen's Paragon enchantments on every worn item, all cursed,
#                    at the character's Paragon level; the template's profile
#                    (mod_ptrtemplate_profile: role, main stat, spec) becomes the character's.
#       Default:     true
#
#   TemplateRemnants
#   TemplateRemnants.Pct
#       Description: Top up each of mod-forgotten-talents' five Remnants to Pct percent of what
#                    its whole tree costs under the live conf.
#       Default:     true, 75

TemplateTalentRanks      = true
TemplateParagon          = true
TemplateParagon.MinLevel = 200
TemplateClassKit         = true
TemplateHunterPet.Entry  = 26672
TemplateParagonRolls     = true
TemplateRemnants         = true
TemplateRemnants.Pct     = 75

#
#    DeleteItems
#        Description: Set whether items in inventory before the template is applied are deleted entirely or sent through the mail.
#        Default:     true  - (Enabled, delete items in inventory)
#                     false - (Disabled, send items through mail)

DeleteItems = true

#
#    LoginTemplateIndex
#        Description: Template index to automatically apply to characters on first login.
#        Default:     0 - (Disabled, no template will be applied)

LoginTemplateIndex = 0

#
#    MaintainImprovedValues
#        Description: If the character has better values than what is set in the template, choose whether they are overwritten or not.
#        Default:     true  - (Enabled, keep the higher values)
#                     false - (Disabled, overwrite regardless of character values)

MaintainImprovedValues = true

#
#    EnableApplySecurity
#        Description: Set the minimum account security level to apply enabled templates.
#        Default:     0  - (Enabled, Everyone)
#                     1  - (Enabled, Mods/GMs/Admins)
#                     2  - (Enabled, GMs/Admins)
#                     3  - (Enabled, Admins)
#                     4  - (Disabled)

EnableApplySecurity = 0

#
#    DisableApplySecurity
#        Description: Set the minimum account security level to apply disabled templates.
#        Default:     3  - (Enabled, Admins)
#                     0  - (Enabled, Everyone)
#                     1  - (Enabled, Mods/GMs/Admins)
#                     2  - (Enabled, GMs/Admins)
#                     4  - (Disabled)

DisableApplySecurity = 3

#
#    EnableListSecurity
#        Description: Set the minimum account security level to list enabled templates.
#        Default:     0  - (Enabled, Everyone)
#                     1  - (Enabled, Mods/GMs/Admins)
#                     2  - (Enabled, GMs/Admins)
#                     3  - (Enabled, Admins)
#                     4  - (Disabled)

EnableListSecurity = 0

#
#    DisableListSecurity
#        Description: Set the minimum account security level to list disabled templates.
#        Default:     2  - (Enabled, GMs/Admins)
#                     0  - (Enabled, Everyone)
#                     1  - (Enabled, Mods/GMs/Admins)
#                     3  - (Enabled, Admins)
#                     4  - (Disabled)

DisableListSecurity = 2

#
#    StatusSecurityText
#        Description: Set the minimum account security level to show "Enabled/Disabled" text when listing templates.
#        Default:     2  - (Enabled, GMs/Admins)
#                     0  - (Enabled, Everyone)
#                     1  - (Enabled, Mods/GMs/Admins)
#                     3  - (Enabled, Admins)
#                     4  - (Disabled)

StatusSecurityText = 2

#
#    ListFilterByClass
#        Description: When a player runs ".template list", only show templates applicable to their class
#                     (derived from the ClassMask of each template's items). Console/GM listing is unaffected.
#        Default:     true  - (Enabled, players see only their own class's templates)
#                     false - (Disabled, show every template to everyone)

ListFilterByClass = true
